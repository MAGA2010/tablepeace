# Optional server-side MiniMax China setup. The key stays on this server.
AI_API_KEY=
AI_BASE_URL=https://api.minimax.cn/v1
AI_MODEL=MiniMax-M2.5

# Conservative per-process usage limits; adjust only on a trusted server.
AI_LIMIT_CALLS_PER_MINUTE=6
AI_LIMIT_CALLS_PER_DAY=40
AI_LIMIT_CALLS_PER_ROOM_DAY=12
AI_LIMIT_CALLS_PER_LINK_DAY=3
AI_LIMIT_LINK_COOLDOWN_SECONDS=5

# Optional local server settings
# TABLEPEACE_DATA_FILE=.data/rooms.json
# HOST=127.0.0.1
# PORT=4178
